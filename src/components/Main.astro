<div id="container">
    <main>
        <section id="hero">
            <p>
                hi, im elliott. a 19-year-old from <button
                    id="denmark"
                    class="action">denmark</button
                > currently studying robotics at <a
                    href="https://www.sdu.dk/en"
                    target="_blank"
                    rel="noopener">SDU</a
                >. i love coding my own solutions to minor inconveniences i meet
                in my daily life, which means i have a graveyard of
                half-finished projects and a few that are actually of use. most
                of them live on <a
                    href="https://github.com/noibs"
                    target="_blank"
                    rel="noopener">github</a
                >. if you want to get in contact with me, shoot me an email at <button
                    class="action email"
                    id="copy-email"
                    data-email="hi@elliott.hu">hi@elliott.hu</button
                >
            </p>
        </section>
    </main>
</div>

<script>
    import { initConfetti } from "../scripts/confetti";
    initConfetti();
</script>

<style>
    :root {
        --bg: #0d0c0b;
        --text-dim: #8f8b85;
        --text-bright: #f2f0ec;
        --font: "Newsreader", var(--font-newsreader), Georgia, serif;
        --size: clamp(1.15rem, 1rem + 0.7vw, 1.45rem);
    }

    * {
        box-sizing: border-box;
    }

    #container {
        margin: 0;
        height: 100%;
    }

    main {
        margin: 0;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;

        font-family: var(--font);
        background-color: var(--bg);
        color: var(--text-dim);
        line-height: 1.62;

        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
    }

    #hero {
        display: flex;
        align-items: center;
        flex-direction: column;
        justify-content: center;
        padding: 2rem 1.5rem;
        max-width: 33rem;
        text-wrap: pretty;
        animation: rise 750ms cubic-bezier(0.215, 0.61, 0.355, 1) both;
    }

    p {
        font-size: 20px;
        font-weight: 400;
        padding: 0;
        margin: 0;
    }

    a,
    .action {
        color: var(--text-bright);
        font: inherit;
        font-weight: 500;
        cursor: pointer;
        text-decoration-line: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.18em;
        text-decoration-color: rgba(242, 240, 236, 0.42);
        transition:
            text-decoration-color 200ms ease,
            color 200ms ease;
    }

    a {
        text-decoration-style: solid;
    }

    .action {
        text-decoration-style: dotted;
        text-underline-offset: 0.2em;

        background: none;
        border: 0;
        padding: 0;
    }

    @media (hover: hover) and (pointer: fine) {
        a:hover,
        .action:hover {
            text-decoration-color: var(--text-bright);
        }
    }

    a:focus-visible,
    .action:focus-visible {
        outline: 1px solid var(--text-dim);
        outline-offset: 3px;
        border-radius: 1px;
        text-decoration-color: var(--text-bright);
    }

    ::selection {
        background: rgba(242, 240, 236, 0.14);
    }

    @keyframes rise {
        from {
            opacity: 0;
            filter: blur(4px);
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            filter: blur(0px);
            transform: none;
        }
    }

    :global(.confetti) {
        position: fixed;
        top: 0;
        left: 0;
        width: 16px;
        height: 12px;
        margin: -6px 0 0 -8px;
        pointer-events: none;
        z-index: 999;
        border-radius: 1px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
        will-change: transform, opacity;
    }

    :global(.confetti svg) {
        display: block;
        width: 100%;
        height: 100%;
    }

    @media screen and (max-width: 768px) {
        #container {
            display: flex;
            flex-direction: column;
        }

        #hero {
            display: block;
            padding-top: 10%;
        }
    }
</style>
