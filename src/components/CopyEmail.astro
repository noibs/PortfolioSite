---
interface Props {
    email: string;
}

const { email } = Astro.props;
---

<span class="copy" data-copy data-email={email}>
    <button class="action" type="button">{email}</button>

    <span class="card copy__card" role="status" aria-live="polite" data-feedback
    ></span>
</span>

<style>
    .copy {
        position: relative;
        white-space: nowrap;
    }

    .copy__card {
        --card-padding: 7px 12px;
        font-size: 0.76rem;
        letter-spacing: 0.02em;
        color: var(--text-bright, #f2f0ec);
        text-align: center;
    }

    /* SVG is inserted via innerHTML so it doesn't carry Astro's scope hash —
       :global() lets these rules match it */
    :global(.copy__check) {
        display: inline-block;
        width: 11px;
        height: 11px;
        margin-right: 6px;
        vertical-align: -1px;
        overflow: visible;
    }

    /* stroke-dashoffset draws the check along its own path — one motion
       following the shape rather than a wipe or a fade */
    :global(.copy__check path) {
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        animation: check-draw 320ms cubic-bezier(0.32, 0.72, 0, 1) 150ms both;
    }

    @keyframes check-draw {
        to {
            stroke-dashoffset: 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        :global(.copy__check path) {
            animation: none;
            stroke-dashoffset: 0;
        }
    }
</style>

<script>
    const HOLD_MS = 1400;

    const CHECK_SVG =
        '<svg class="copy__check" width="11" height="11" ' +
        'viewBox="0 0 12 12" fill="none" ' +
        'xmlns="http://www.w3.org/2000/svg" aria-hidden="true">' +
        '<path d="M2 6.5 L5 9.5 L10 3" stroke="currentColor" ' +
        'stroke-width="1.75" stroke-linecap="round" ' +
        'stroke-linejoin="round" pathLength="1"/></svg>';

    function initCopy(root: HTMLElement): void {
        const button = root.querySelector<HTMLButtonElement>("button");
        const card = root.querySelector<HTMLElement>("[data-feedback]");
        const email = root.dataset.email;
        if (!button || !card || !email) return;

        let timer: number | undefined;

        const show = (html: string) => {
            card.innerHTML = html;
            card.classList.add("is-open");
            window.clearTimeout(timer);
            timer = window.setTimeout(
                () => card.classList.remove("is-open"),
                HOLD_MS,
            );
        };

        button.addEventListener("click", async () => {
            try {
                await navigator.clipboard.writeText(email);
                show(CHECK_SVG + "copied");
            } catch {
                // clipboard needs a secure context, and can still be refused —
                // don't claim success. select the text so they can copy it themselves.
                const range = document.createRange();
                range.selectNodeContents(button);
                const sel = window.getSelection();
                sel?.removeAllRanges();
                sel?.addRange(range);
                show("press ⌘C to copy");
            }
        });
    }

    document.querySelectorAll<HTMLElement>("[data-copy]").forEach(initCopy);
</script>
