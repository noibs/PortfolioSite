---
import { Font } from "astro:assets";
import { age } from "../scripts/age";

// search engines and link previews only ever see the built html, so this
// is as current as the last deploy
const description = `hi, im elliott. ${age()}, robotics at SDU.`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#100e0c" />
        <meta name="color-scheme" content="dark" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.svg" />
        <Font cssVariable="--font-newsreader" preload />
        <title>elliott</title>
        <meta name="description" content={description} />
        <link rel="canonical" href="https://elliott.hu" />
        <meta property="og:title" content="elliott" />
        <meta property="og:description" content={description} />
        <meta property="og:url" content="https://elliott.hu" />
        <meta property="og:type" content="website" />
        <meta name="twitter:card" content="summary" />
    </head>
    <body>
        <slot />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
        /* ground the whole document so overscroll never flashes white.
           written as hex on purpose: some browsers (e.g. lens on ios) tint
           their toolbars by reading the page's background color, and can't
           parse the oklch() string modern browsers report, so they fall
           back to white. the value is --bg with the film grain averaged in
           (measured), so the toolbars match what the page looks like rather
           than the flat color under the grain. keep in sync with the
           theme-color meta */
        background: #100e0c;
    }
</style>
